{
	"name": "hellocloud/php-resque",
	"type": "library",
	"replace": {
		"chrisboulton/php-resque":  "*",
		"danhunsaker/php-resque": "*",
		"resque/php-resque": "*"
	},
	"description": "Redis backed library for creating background jobs and processing them later. Based on resque for Ruby. Originally forked from chrisboulton/php-resque.",
	"keywords": ["job", "background", "redis", "resque", "php"],
	"homepage": "https://github.com/HelloCloud-Projects/php-resque",
	"license": "MIT",
	"authors": [
		{
			"name": "HelloCloud",
			"email": "support@hellocloud.com.br"
		}
	],
	"require": {
		"php": ">=8.3",
		"psr/log": "^1.1 || ^2.0 || ^3.0",
		"colinmollenhour/credis": "^1.17.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.3",
		"carthage-software/mago": "~1.44.0"
	},
	"bin": [
		"bin/resque"
	],
	"autoload": {
		"psr-4": {
			"Resque\\": "src/Resque"
		},
		"files": ["src/aliases.php"]
	},
	"autoload-dev": {
		"psr-4": {
			"Resque\\Test\\": "tests/Resque/Tests"
		}
	},
	"support": {
		"issues": "https://github.com/HelloCloud-Projects/php-resque/issues",
		"source": "https://github.com/HelloCloud-Projects/php-resque"
	}
}
